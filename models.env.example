# 可由智能体读取和修改。两阶段分别选择 local 或 api。下列模型字段仅用于本地服务。
# 远端地址、模型和密钥填 private/remote_api.env。
GRAPH_MODEL_MODE=local
AGENT_MODEL_MODE=local
# Worker counts only apply to the api mode of each stage.
GRAPH_MODEL_WORKERS=6
AGENT_MODEL_WORKERS=6
# MODEL_REVISION 填下载产物 source_manifest.json 的 revision；当前服务器已填写。
GRAPH_LLM_BASE_URL=http://127.0.0.1:18082/v1
GRAPH_LLM_MODEL=Qwen3-4B-Instruct-2507
GRAPH_MODEL_REVISION=
GRAPH_ENABLE_THINKING=false
GRAPH_THINKING_CONTROL=non_thinking_model
GRAPH_TEMPERATURE=0.2
GRAPH_MAX_OUTPUT_TOKENS=220
GRAPH_REQUEST_TIMEOUT_SECONDS=240
GRAPH_MAX_HTTP_ATTEMPTS=5
EMBED_MODEL_PATH=assets/models/bge-m3
EMBED_MODEL_REVISION=
EMBED_MAX_INPUT_TOKENS=8192
EMBED_OVERLAP_TOKENS=128
EMBED_BATCH_SIZE=16
EMBED_CHUNK_ROWS=64
EMBED_L2_NORMALIZE=true
AGENT_LLM_BASE_URL=http://127.0.0.1:18082/v1
AGENT_LLM_MODEL=Qwen3-4B-Instruct-2507
AGENT_MODEL_REVISION=
AGENT_ENABLE_THINKING=false
AGENT_THINKING_CONTROL=non_thinking_model
AGENT_TEMPERATURE=0
AGENT_REGENERATE_TEMPERATURE=0.2
AGENT_MAX_OUTPUT_TOKENS=2048
AGENT_TOKENIZER_PATH=assets/models/Qwen3-4B-Instruct-2507
AGENT_CHAT_TEMPLATE_FILE=
AGENT_CONTEXT_WINDOW_TOKENS=8192
AGENT_CONTEXT_SAFETY_TOKENS=256
AGENT_REQUEST_TIMEOUT_SECONDS=240
AGENT_MAX_HTTP_ATTEMPTS=5
