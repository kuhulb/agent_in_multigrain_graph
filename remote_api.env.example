# 用户维护。将本模板复制到项目 private/remote_api.env，并将权限设为 600。
# BASE_URL 填中转提供的 HTTPS API 根地址，通常以 /v1 结尾。
# MODEL 填中转平台实际提供的模型名称，KEY 填中转平台的密钥。
# 只用 API 做推理时，只需填写 AGENT 段。留空的 GRAPH 段不影响本地构图。

# Agent inference. Fill context according to the relay's effective limit.
AGENT_API_BASE_URL=
AGENT_API_MODEL=
AGENT_API_KEY=
AGENT_API_CONTEXT_WINDOW_TOKENS=1000000
AGENT_API_ADAPTER=deepseek
AGENT_API_ENABLE_THINKING=false
AGENT_API_THINKING_CONTROL=deepseek
AGENT_API_TOOL_CHOICE=auto
# Optional. Use matching local tokenizer and template files when available.
AGENT_API_TOKENIZER_PATH=
AGENT_API_CHAT_TEMPLATE_FILE=
AGENT_API_CONTEXT_SAFETY_TOKENS=1024
AGENT_API_MAX_OUTPUT_TOKENS=2048
AGENT_API_TEMPERATURE=0
AGENT_API_REGENERATE_TEMPERATURE=0.2
AGENT_API_REQUEST_TIMEOUT_SECONDS=240
AGENT_API_MAX_HTTP_ATTEMPTS=5
AGENT_API_RPM=2500
AGENT_API_TPM=5000000
AGENT_API_REVISION=

# Optional remote community summaries.
GRAPH_API_BASE_URL=
GRAPH_API_MODEL=
GRAPH_API_KEY=
GRAPH_API_ADAPTER=deepseek
GRAPH_API_ENABLE_THINKING=false
GRAPH_API_THINKING_CONTROL=deepseek
GRAPH_API_MAX_OUTPUT_TOKENS=220
GRAPH_API_TEMPERATURE=0.2
GRAPH_API_REQUEST_TIMEOUT_SECONDS=240
GRAPH_API_MAX_HTTP_ATTEMPTS=5
# Set quotas for the actual provider selected for summaries.
GRAPH_API_RPM=
GRAPH_API_TPM=
GRAPH_API_REVISION=
